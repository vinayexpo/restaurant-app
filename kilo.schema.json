{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "./kilo.schema.json",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "mcp": {
      "type": "object",
      "additionalProperties": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "type": {
                "const": "remote"
              },
              "url": {
                "type": "string"
              },
              "enabled": {
                "type": "boolean"
              },
              "headers": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                }
              },
              "timeout": {
                "type": "integer",
                "minimum": 1
              }
            },
            "required": ["type", "url"],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "const": "local"
              },
              "command": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "minItems": 1
              },
              "cwd": {
                "type": "string"
              },
              "environment": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                }
              },
              "enabled": {
                "type": "boolean"
              },
              "timeout": {
                "type": "integer",
                "minimum": 1
              }
            },
            "required": ["type", "command"],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "enabled": {
                "type": "boolean"
              }
            },
            "required": ["enabled"],
            "additionalProperties": false
          }
        ]
      }
    }
  },
  "additionalProperties": true
}
